{
  "name": "@onekeyhq/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "description": "OneKey Monorepo",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all run build",
    "build:sync": "yarn workspace @onekeyhq/cloud-sync-server build",
    "build:mock": "yarn workspace @onekeyhq/mock-app build",
    "dev": "yarn workspace @onekeyhq/transfer-server dev",
    "dev:sync": "yarn workspace @onekeyhq/cloud-sync-server dev",
    "dev:mock": "yarn workspace @onekeyhq/mock-app dev",
    "start": "yarn workspace @onekeyhq/transfer-server start",
    "start:mock": "yarn workspace @onekeyhq/mock-app start",
    "test": "yarn workspaces foreach --all run test",
    "test:sync": "yarn workspace @onekeyhq/cloud-sync-server test",
    "test:mock": "yarn workspace @onekeyhq/mock-app test",
    "lint": "eslint packages/*/src packages/*/test examples/*/src examples/*/test --max-warnings 0",
    "lint:sync": "yarn workspace @onekeyhq/cloud-sync-server lint",
    "clean": "yarn workspaces foreach --all run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@midwayjs/core": "^3.20.11",
    "@midwayjs/decorator": "^3.20.11",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/validate": "^3.20.12",
    "mongoose": "^8.17.1"
  }
}
